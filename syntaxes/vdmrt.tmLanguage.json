{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "VDM-RT",
    "patterns": [
        {
            "name": "storage.type.vdm",
            "match": "(?<![\\w$'])(system)(?![\\w$'])"
        },
        {
            "name": "keyword.other.value.vdm",
            "match": "(?<![\\w$'])(async|time)(?![\\w$'])"
        },
        {
            "name": "keyword.other.value.vdm",
            "match": "(?<![\\w$'])(cycles|duration)(?![\\w$'])"
        },
        {
            "include": "source.vdmpp"
        }
    ],
    "scopeName": "source.vdmrt"
}
