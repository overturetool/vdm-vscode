{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "VDM-SL",
    "patterns": [
        {
            "include": "source.vdm"
        },
        {
            "name": "meta.module.vdmsl",
            "begin": "(?<![\\w$'])(module)(?![\\w$'])",
            "beginCaptures": { "1": { "name": "storage.type.vdm" } },
            "end": "(?<!\\\\)(?<![\\w$'])(end)(?![\\w$'])",
            "endCaptures": { "1": { "name": "storage.type.vdm" } },
            "patterns": [{ "include": "$self" }]
        },
        {
            "name": "storage.type.vdm",
            "match": "(?<![\\w$'])(imports|from|init|renamed|uselib)(?![\\w$'])"
        },
        {
            "name": "keyword.type.vdm",
            "match": "(?<![\\w$'])(exports)(?![\\w$'])"
        }
    ],
    "scopeName": "source.vdmsl"
}
