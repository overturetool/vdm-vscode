{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "VDM++",
    "patterns": [
        {
            "name": "storage.type.class.vdmpp",
            "match": "(?<![\\w$'])(class|self)(?![\\w$'])"
        },
        {
            "name": "storage.type.definition.class.vdmpp",
            "match": "(?<![\\w$'])(thread|sync|instance|variables)(?![\\w$'])"
        },
        {
            "name": "keyword.other.subclassResposibility.vdmpp",
            "match": "(?<![\\w$'])(is subclass responsibility)(?![\\w$'])"
        },
        {
            "name": "keyword.other.history.vdmpp",
            "match": "(\\#act|\\#active|\\#fin|\\#req|\\#waiting)(?![\\w$'])"
        },
        {
            "name": "support.function.membership.vdmpp",
            "match": "(?<![\\w$'])(isofbaseclass|isofclass|samebaseclass|sameclass|subclass)(?![\\w$'])"
        },
        {
            "name": "support.function.sync.vdmpp",
            "match": "(?<![\\w$'])(mutex|per)(?![\\w$'])"
        },
        {
            "name": "keyword.other.thread.vdmpp",
            "match": "(?<![\\w$'])(periodic|sporadic|threadid)(?![\\w$'])"
        },
        {
            "name": "support.function.startstop.vdmpp",
            "match": "(?<![\\w$'])(start|startlist|stop|stoplist)(?![\\w$'])"
        },
        {
            "include": "source.vdm"
        }
    ],
    "scopeName": "source.vdmpp"
}
