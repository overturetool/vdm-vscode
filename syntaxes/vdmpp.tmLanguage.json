{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "VDM++",
    "patterns": [
        {
            "name": "meta.class.vdmpp",
            "begin": "(?<![\\w$'])(class)(?![\\w$'])",
            "beginCaptures": { "1": { "name": "storage.type.vdm" } },
            "end": "(?<!\\\\)(?<![\\w$'])(end)(?![\\w$'])",
            "endCaptures": { "1": { "name": "storage.type.vdm" } },
            "patterns": [{ "include": "$self" }]
        },
        {
            "name": "keyword.other.value.vdm",
            "match": "(?<![\\w$'])(self)(?![\\w$'])"
        },
        {
            "name": "storage.type.vdm",
            "match": "(?<![\\w$'])(thread|sync|instance|variables)(?![\\w$'])"
        },
        {
            "name": "keyword.other.value.vdm",
            "match": "(?<![\\w$'])(is subclass responsibility)(?![\\w$'])"
        },
        {
            "name": "keyword.other.value.vdm",
            "match": "(\\#act|\\#active|\\#fin|\\#req|\\#waiting)(?![\\w$'])"
        },
        {
            "name": "keyword.other.value.vdm",
            "match": "(?<![\\w$'])(isofbaseclass|isofclass|samebaseclass|sameclass)(?![\\w$'])"
        },
        {
            "name": "storage.type.vdm",
            "match": "(?<![\\w$'])(subclass)(?![\\w$'])"
        },
        {
            "name": "storage.type.vdm",
            "match": "(?<![\\w$'])(mutex|per)(?![\\w$'])"
        },
        {
            "name": "storage.type.vdm",
            "match": "(?<![\\w$'])(periodic|sporadic)(?![\\w$'])"
        },
        {
            "name": "keyword.other.value.vdm",
            "match": "(?<![\\w$'])(threadid)(?![\\w$'])"
        },
        {
            "name": "keyword.other.value.vdm",
            "match": "(?<![\\w$'])(start|startlist|stop|stoplist)(?![\\w$'])"
        },
        {
            "include": "source.vdm"
        }
    ],
    "scopeName": "source.vdmpp"
}
