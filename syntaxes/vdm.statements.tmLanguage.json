{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "statements",
    "patterns": [
        {
            "include": "#statements"
        }
    ],
    "repository": {
        "statements": {
            "name": "meta.statements.vdm",
            "patterns": [
                {
                    "include": "#cases-block"
                },
                {
                    "include": "#control-statements"
                },
                {
                    "include": "#local-binding-statements"
                },
                {
                    "include": "#expressions"
                },
                {
                    "include": "#not-specified"
                },
                {
                    "include": "#others"
                },
                {
                    "include": "#operator"
                }
            ]
        },
        "control-statements": {
            "patterns": [
                {
                    "name": "keyword.control.value.vdm",
                    "match": "(?<![\\w$'])(if|then|else|elseif|return|while|for|do|measure|by|others|tixe|trap|with)(?![\\w$'])"
                }
            ]
        },
        "cases-block": {
            "name": "meta.cases.vdm",
            "begin": "(?<![\\w$'])(cases)(?![\\w$'])",
            "beginCaptures": { "1": { "name": "keyword.control.value.vdm" } },
            "end": "(?<!\\\\)(?<![\\w$'])(end)(?![\\w$'])",
            "endCaptures": { "1": { "name": "keyword.control.value.vdm" } },
            "patterns": [{ "include": "$self" }]
        },
        "local-binding-statements": {
            "patterns": [
                {
                    "name": "keyword.other.value.vdm",
                    "match": "(?<![\\w$'])(let|be st|in|be|st)(?![\\w$'])"
                }
            ]
        },
        "not-specified": {
            "patterns": [
                {
                    "name": "keyword.other.value.vdm",
                    "match": "(?<![\\w$'])(is not yet specified)(?![\\w$'])"
                }
            ]
        },
        "others": {
            "patterns": [
                {
                    "name": "storage.type.vdm",
                    "match": "(\\#if|\\#else|\\#endif|\\#ifdef|\\#ifndef)(?![\\w$'])"
                },
                {
                    "name": "keyword.other.value.vdm",
                    "match": "(?<![\\w$'])RESULT(?![\\w$'])"
                }
            ]
        }
    },
    "scopeName": "source.vdm.statements"
}
