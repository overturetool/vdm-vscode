{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "statements",
    "patterns": [
        {
            "include": "#statements"
        }
    ],
    "repository": {
        "statements": {
            "name": "meta.statements.vdm",
            "patterns": [
                {
                    "include": "#control-statements"
                },
                {
                    "include": "#local-binding-statements"
                },
                {
                    "include": "#expressions"
                },
                {
                    "include": "#not-specified"
                },
                {
                    "include": "#others"
                },
                {
                    "include": "#operator"
                }
            ]
        },
        "control-statements": {
            "patterns": [
                {
                    "name": "keyword.control.statements.conditional.vdm",
                    "match": "(?<![\\w$'])(if|then|else|elseif|cases|return|while|for|do|measure|renamed|by|others|tixe|trap|with)(?![\\w$'])"
                }
            ]
        },
        "local-binding-statements": {
            "patterns": [
                {
                    "name": "keyword.control.localBinding.vdm",
                    "match": "(?<![\\w$'])(let|be st|in|be|st)(?![\\w$'])"
                }
            ]
        },
        "not-specified": {
            "patterns": [
                {
                    "name": "keyword.other.notSpecified.vdm",
                    "match": "(?<![\\w$'])(is not yet specified)(?![\\w$'])"
                }
            ]
        },
        "others": {
            "patterns": [
                {
                    "name": "keyword.other.vdm",
                    "match": "(\\#if|\\#else|\\#endif|\\#ifdef|\\#ifndef|RESULT)(?![\\w$'])"
                }
            ]
        }
    },
    "scopeName": "source.vdm.statements"
}
