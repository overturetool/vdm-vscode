{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "operators",
    "patterns": [
        {
            "include": "#assignment"
        },
        {
            "include": "#combinators"
        },
        {
            "include": "#map"
        },
        {
            "include": "#set"
        },
        {
            "include": "#seq"
        },
        {
            "include": "#applicators"
        },
        {
            "include": "#evaluators"
        },
        {
            "include": "#relations"
        },
        {
            "include": "#type"
        },
        {
            "include": "#new"
        },
        {
            "include": "#connectives"
        },
        {
            "include": "#other"
        }
    ],
    "repository": {
        "assignment": {
            "name": "keyword.operator.assignment.vdm",
            "match": "(=)"
        },
        "combinators": {
            "name": "keyword.other.combinators.vdm",
            "match": "(?<![\\w$'])(\\*\\*|comp)(?![\\w$'])"
        },
        "applicators": {},
        "arithmetic": {
            "name": "keyword.operator.arithmetic.vdm",
            "match": "\\b(\\+|\\-|\\*|\\/|\\\\|\\^)\\b"
        },
        "map": {
            "name": "keyword.operator.map.vdm",
            "match": "\\b(\\+\\+|\\<\\:|\\<\\-\\:|\\:\\>|\\:\\-\\>)\\b"
        },
        "evaluators": {
            "name": "keyword.other.evaluators.vdm",
            "match": "(?<![\\w$'])(abs|floor|card|power|dunion|dinter|hd|tl|len|inds|elems|conc|reverse|dom|rng|merge|inverse|rem|mod|div|union|inter|munion)(?![\\w$'])"
        },
        "relations": {
            "name": "keyword.operator.relations.vdm",
            "match": "\\b(<=|>=|<|>|=|==|<>)\\b"
        },
        "set": {
            "name": "keyword.other.set.vdm",
            "match": "(?<![\\w$'])(subset|psubset|in set|not in set)(?![\\w$'])"
        },
        "seq": {
            "name": "keyword.other.seq.vdm",
            "match": "(?<![\\w$'])(in seq|in seq1)(?![\\w$'])"
        },
        "connectives": {
            "name": "keyword.other.connectives.vdm",
            "match": "(?<![\\w$'])(not|and|or|=>|<=>)(?![\\w$'])"
        },
        "type": {},
        "new": {
            "name": "keyword.operator.new.vdm",
            "match": "(?<![\\w$'])(new)(?![\\w$'])"
        },
        "other": {
            "name": "keyword.other.vdm",
            "match": "(?<![\\w$'])(\\.\\.\\.|forall|exists|exists1|iota|lambda|all|eq|ord|compose|is|of)(?![\\w$'])"
        }
    },
    "scopeName": "source.vdm.operators"
}
