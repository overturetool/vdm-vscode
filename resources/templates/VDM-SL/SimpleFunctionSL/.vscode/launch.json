{
    "configurations": [
        {
            // Launch the interpreter in debug mode.
            // 'defaultName' is not needed for VDM-SL without a module.
            "name": "Launch Add",
            "type": "vdm",
            "request": "launch",
            "noDebug": false,
            "defaultName": null,
            // 'command' runs a single expression and terminates.
            // Remove it to open an interactive console instead.
            "command": "print Add(1, 2)"
        }
    ]
}